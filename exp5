clc;
clear;
close all;

data = [1 0 1 1 0 0 1 0];

Tb = 1;
fc = 5;
Fs = 100;

t = 0:1/Fs:8*Tb-1/Fs;

msg = repelem(data,100);

carrier = cos(2*pi*fc*t);

bpsk = repelem(2*data-1,100).*carrier;

pairs = reshape(data,2,[])';

I = 2*pairs(:,1)-1;
Q = 2*pairs(:,2)-1;

qpsk = [];

for k = 1:length(I)
    tq = (0:199)/Fs;
    qpsk = [qpsk I(k)*cos(2*pi*fc*tq) ...
        - Q(k)*sin(2*pi*fc*tq)];
end

figure;

subplot(4,1,1);
plot(t,msg,'LineWidth',2);
title('Message Signal');
xlabel('Time');
ylabel('Amplitude');
grid on;

subplot(4,1,2);
plot(t,carrier);
title('Carrier Signal');
xlabel('Time');
ylabel('Amplitude');
grid on;

subplot(4,1,3);
plot(t,bpsk);
title('BPSK Signal');
xlabel('Time');
ylabel('Amplitude');
grid on;

subplot(4,1,4);
plot(t,qpsk);
title('QPSK Signal');
xlabel('Time');
ylabel('Amplitude');
grid on;
