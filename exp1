clc; 
clear; 
close all; 
t = 0:0.001:0.2; 
x = cos(2*pi*10*t); 
tsu = 0:0.1:0.2;     
tsn = 0:.05:0.2;     
tso = 0:0.0125:0.2;    
xsu = cos(2*pi*10*tsu); 
xsn = cos(2*pi*10*tsn); 
xso = cos(2*pi*10*tso); 
subplot(3,1,1); 
plot(t,x,'b'); 
hold on; 
stem(tsu,xsu,'r','filled'); 
title('Under Sampling'); 
xlabel('Time'); 
ylabel('Amplitude'); 
grid on; 
subplot(3,1,2); 
plot(t,x,'b'); 
hold on; 
stem(tsn,xsn,'r','filled'); 
title('Nyquist Sampling'); 
xlabel('Time'); 
ylabel('Amplitude'); 
grid on; 
subplot(3,1,3); 
plot(t,x,'b'); 
hold on; 
stem(tso,xso,'r','filled'); 
title('Over Sampling'); 
xlabel('Time'); 
ylabel('Amplitude'); 
grid on;
